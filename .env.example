# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brussels_mobility
DB_USER=your_user
DB_PASSWORD=your_password

# STIB GTFS timetable (zip, no account needed)
GTFS_URL=https://stibmivb.opendatasoft.com/api/datasets/1.0/gtfs-files-production/alternative_exports/gtfszip/

# STIB real-time API
# Works without a key (100 requests/day). A free developer account gives higher limits.
VEHICLE_POSITIONS_URL=https://api-management-discovery-production.azure-api.net/api/datasets/stibmivb/rt/VehiclePositions
STIB_API_KEY=your_api_key