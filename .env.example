# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brussels_mobility
DB_USER=your_user
DB_PASSWORD=your_password

# STIB GTFS timetable (zip, no account needed)
GTFS_URL=https://stibmivb.opendatasoft.com/api/datasets/1.0/gtfs-files-production/alternative_exports/gtfszip/

# STIB real-time API (free developer account, used in a later step)
STIB_API_KEY=your_api_key