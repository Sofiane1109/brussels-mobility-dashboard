# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brussels_mobility
DB_USER=your_user
DB_PASSWORD=your_password

# Open data API (fill in once the data source is chosen)
API_BASE_URL=https://opendata.brussels.be
API_KEY=your_api_key_if_needed
